# @hce/design-system
# Storybook (dev local vía `npm run storybook` corre en :10101, hardcodeado en package.json — no configurable por env)

# ── docker-compose.yml: servicio storybook (Storybook estático servido por nginx) ──
PORT=80
SSL_PORT=443
USE_SSL=true
# Ruta a certs dentro del contenedor (montada desde /proyectos/certs en el host)
CERT_PATH=/proyectos/certs
# spa|remote — este repo siempre usa "spa" (Storybook es un build estático, no un remote de Module Federation)
NGINX_TYPE=spa

# ── docker-compose.yml: servicio publisher (perfil "publish", build + npm publish a Verdaccio) ──
# Verdaccio corre en el repo hermano hce-verdaccio-registry.
# Valor real por defecto en docker-compose.yml (contenedor publisher -> host):
# http://host.docker.internal:10100
# Alternativas: desde el host/local http://localhost:10100 — contra el
# registry compartido de equipo http://192.168.42.44:10100
VERDACCIO_URL=http://host.docker.internal:10100
# Token npm para publicar sin login interactivo (opcional, vacío por defecto)
NPM_TOKEN=
